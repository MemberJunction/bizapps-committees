{
  "$schema": "https://schema.memberjunction.org/mj-app/v1.json",
  "manifestVersion": 1,
  "name": "mj-committees",
  "displayName": "Committees",
  "description": "Unified governance platform for managing committees, memberships, meetings, action items, and documents — with AI-powered minutes generation and health analytics",
  "version": "1.1.0",
  "license": "ISC",
  "icon": "fa-solid fa-users-rectangle",
  "publisher": {
    "name": "MemberJunction",
    "url": "https://memberjunction.com"
  },
  "repository": "https://github.com/MemberJunction/bizapps-committees",
  "mjVersionRange": ">=6.1.0-edge.2 <7.0.0",
  "dependencies": [
    {
      "name": "mj-bizapps-common",
      "repository": "https://github.com/MemberJunction/bizapps-common",
      "versionRange": ">=5.33.2 <6.0.0"
    },
    {
      "name": "mj-bizapps-tasks",
      "repository": "https://github.com/MemberJunction/bizapps-tasks",
      "versionRange": ">=1.2.1 <2.0.0"
    }
  ],
  "schema": {
    "name": "__mj_BizAppsCommittees",
    "createIfNotExists": true
  },
  "migrations": {
    "directory": "migrations",
    "engine": "skyway"
  },
  "metadata": {
    "directory": "metadata"
  },
  "packages": {
    "prefix": "@mj-biz-apps/committees-",
    "server": [
      {
        "name": "@mj-biz-apps/committees-server",
        "role": "bootstrap",
        "startupExport": "LoadCommitteesServer"
      }
    ],
    "client": [
      {
        "name": "@mj-biz-apps/committees-ng",
        "role": "bootstrap",
        "startupExport": "LoadCommitteesClient"
      }
    ],
    "shared": [
      {
        "name": "@mj-biz-apps/committees-entities",
        "role": "library"
      },
      {
        "name": "@mj-biz-apps/committees-core-entities-server",
        "role": "library"
      },
      {
        "name": "@mj-biz-apps/committees-core",
        "role": "library"
      },
      {
        "name": "@mj-biz-apps/committees-actions",
        "role": "library"
      }
    ]
  },
  "code": {
    "visibility": "public",
    "sourceDirectory": "packages"
  },
  "categories": [
    "Business",
    "Governance"
  ],
  "tags": [
    "committees",
    "governance",
    "meetings",
    "action-items",
    "minutes",
    "voting"
  ]
}
