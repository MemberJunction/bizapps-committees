{
  "name": "bizapps-committees",
  "version": "1.0.0",
  "license": "ISC",
  "description": "MemberJunction distribution monorepo - includes MJAPI, MJExplorer, and code generation tools",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prebuild": "node -e \"try { require.resolve('turbo') } catch (e) { console.error('\\n❌ Dependencies not installed. Run: npm install\\n'); process.exit(1); }\"",
    "postinstall": "echo 'MemberJunction installation complete. Please configure your environment using install.config.json or mj.config.cjs before proceeding.'",
    "build": "npm run build:stream",
    "build:stream": "turbo --log-order=stream build",
    "build:generated": "turbo --log-order=stream build --filter=\"@mj-biz-apps/committees-entities\" --filter=\"@mj-biz-apps/committees-actions\"",
    "build:api": "turbo --log-order=stream build --filter=\"mj_api\"",
    "build:explorer": "turbo --log-order=stream build --filter=\"mj_explorer\"",
    "start": "turbo start --filter=mj_explorer --filter=mj_api",
    "start:api": "turbo start --filter=mj_api",
    "start:explorer": "turbo start --filter=mj_explorer",
    "mj": "mj",
    "mj:migrate": "mj migrate --schema __mj_BizAppsCommittees --dir ./migrations",
    "mj:codegen": "mj codegen",
    "install:deps": "npm install",
    "setup": "echo 'Please run: npm run mj:migrate && npm run mj:codegen && npm run build'",
    "build:packages": "turbo --log-order=stream build --filter=\"@mj-biz-apps/committees-*\"",
    "test": "turbo test",
    "change": "changeset",
    "version": "changeset version",
    "commitpush": "node ci/commit_push.mjs",
    "mergemain": "node ci/merge_main.mjs",
    "mergemain:update-lock": "node ci/merge_main_and_update_lock.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/bizapps-committees"
  },
  "packageManager": "npm@10.5.0",
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@memberjunction/cli": "^5.44.0",
    "@vitest/coverage-v8": "1.6.1",
    "beasties": "0.3.5",
    "simple-git": "^3.31.1",
    "tsc-alias": "^1.8.16",
    "turbo": "^2.9.3",
    "typescript": "^5.9.3",
    "vitest": "1.6.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "zod": "^3.25.28",
    "@types/node": "20.14.2",
    "@angular/animations": "21.1.3",
    "@angular/cli": "21.1.3",
    "@angular/common": "21.1.3",
    "@angular/compiler": "21.1.3",
    "@angular/compiler-cli": "21.1.3",
    "@angular/core": "21.1.3",
    "@angular/forms": "21.1.3",
    "@angular/localize": "21.1.3",
    "@angular/platform-browser": "21.1.3",
    "@angular/platform-browser-dynamic": "21.1.3",
    "@angular/router": "21.1.3",
    "@angular/service-worker": "21.1.3",
    "@memberjunction/core": "^5.44.0",
    "@memberjunction/global": "^5.44.0"
  }
}
