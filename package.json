{
  "name": "bizapps-committees",
  "version": "1.0.0",
  "license": "ISC",
  "description": "BizApps Committees - committee, membership, meeting, minutes and ballot primitives built on MemberJunction",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prebuild": "node -e \"try { require.resolve('turbo') } catch (e) { console.error('\\n❌ Dependencies not installed. Run: pnpm install\\n'); process.exit(1); }\" && pnpm run check:pg-parity",
    "postinstall": "echo 'MemberJunction installation complete. Please configure your environment using install.config.json or mj.config.cjs before proceeding.'",
    "build": "pnpm run build:stream",
    "build:stream": "turbo --log-order=stream build --filter=\"@mj-biz-apps/*\"",
    "build:generated": "turbo --log-order=stream build --filter=\"@mj-biz-apps/committees-entities\" --filter=\"@mj-biz-apps/committees-actions\"",
    "mj": "mj",
    "mj:migrate": "mj migrate --schema __mj_BizAppsCommittees --dir ./migrations",
    "mj:migrate:convert": "mj migrate convert --source-dir ./migrations --output-dir ./migrations-pg --schema __mj_BizAppsCommittees && node scripts/pg-finalize.mjs",
    "mj:codegen": "mj codegen",
    "test:objectmodel:pg": "node scripts/pg-objectmodel-test.mjs",
    "install:deps": "pnpm install",
    "setup": "echo 'Please run: pnpm run mj:migrate && pnpm run mj:codegen && pnpm run build'",
    "build:packages": "turbo --log-order=stream build --filter=\"@mj-biz-apps/committees-*\"",
    "test": "turbo test",
    "change": "changeset",
    "version": "changeset version",
    "commitpush": "node ci/commit_push.mjs",
    "mergemain": "node ci/merge_main.mjs",
    "mergemain:update-lock": "node ci/merge_main_and_update_lock.mjs",
    "test:harness": "pnpm run test:harness:metadata && pnpm run test:harness:governance && pnpm run test:harness:ballot",
    "test:harness:metadata": "tsx test-harnesses/server/metadata-integrity.mts",
    "test:harness:governance": "tsx test-harnesses/server/governance-loop-runtime.mts",
    "test:harness:ballot": "tsx test-harnesses/server/ballot-runtime.mts",
    "check:pg-parity": "node scripts/check-pg-parity.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/bizapps-committees"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@memberjunction/cli": "^6.1.0-edge.2",
    "@vitest/coverage-v8": "1.6.1",
    "beasties": "0.3.5",
    "simple-git": "^3.31.1",
    "tsc-alias": "^1.8.16",
    "turbo": "^2.9.3",
    "typescript": "^5.9.3",
    "vitest": "1.6.1",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "zod": "^3.25.28",
      "@types/node": "20.14.2",
      "@types/express": "^5.0.6",
      "@angular/animations": "21.1.3",
      "@angular/cli": "21.1.3",
      "@angular/common": "21.1.3",
      "@angular/compiler": "21.1.3",
      "@angular/compiler-cli": "21.1.3",
      "@angular/core": "21.1.3",
      "@angular/forms": "21.1.3",
      "@angular/localize": "21.1.3",
      "@angular/platform-browser": "21.1.3",
      "@angular/platform-browser-dynamic": "21.1.3",
      "@angular/router": "21.1.3",
      "@angular/service-worker": "21.1.3",
      "@memberjunction/core": "^6.1.0-edge.2",
      "@memberjunction/global": "^6.1.0-edge.2"
    }
  }
}
