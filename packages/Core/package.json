    "test": "vitest run"
  },
  "author": "MemberJunction.com",
  "license": "ISC",
  "devDependencies": {
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "1.6.1"
  },
  "peerDependencies": {
    "@memberjunction/core": "^5.45.0",
    "@memberjunction/global": "^5.45.0"
  },
  "dependencies": {
    "@mj-biz-apps/common-entities": "^5.31.3",
    "@mj-biz-apps/committees-entities": "1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/bizapps-committees"
  }
