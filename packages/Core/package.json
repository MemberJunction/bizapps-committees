{
  "name": "@mj-biz-apps/committees-core",
  "type": "module",
  "version": "1.1.0",
  "description": "Core business logic services for the Committees OpenApp",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lookup": {
      "types": "./dist/engines/CommitteesLookupEngine.d.ts",
      "import": "./dist/engines/CommitteesLookupEngine.js"
    }
  },
  "publishConfig": {
